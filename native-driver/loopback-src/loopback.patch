+//=============================================================================
+#pragma code_seg()
+VOID CMiniportWaveRTStream::ReadBytesForLoopback
+(
+    _In_ ULONG ByteDisplacement
+)
+/*++
+
+Routine Description:
+
+  SoundPipe loopback producer. Reads the freshly-rendered audio out of this
+  render stream's DMA buffer and pushes it into the global loopback FIFO, from
+  which a capture (microphone) stream drains it. Stereo render audio is
+  downmixed to mono inside the FIFO.
+
+Arguments:
+
+  ByteDisplacement - # of bytes rendered since the last tick.
+
+--*/
+{
+    // Only render pins backed by a simple WaveRT DMA buffer carry PCM we can read
+    // here. Other render pins (offload via the audio engine, the WASAPI loopback
+    // pin) have no m_pDmaBuffer - dereferencing it would read a near-NULL address
+    // at DISPATCH_LEVEL (bugcheck 0xD1). Also guards against divide-by-zero below.
+    if (m_pDmaBuffer == NULL || m_ulDmaBufferSize == 0 || m_pWfExt == NULL)
+    {
+        return;
+    }
+
+    USHORT channels = m_pWfExt->Format.nChannels;
+    ULONG  bufferOffset = m_ullLinearPosition % m_ulDmaBufferSize;
+
+    while (ByteDisplacement > 0)
+    {
+        ULONG runWrite = min(ByteDisplacement, m_ulDmaBufferSize - bufferOffset);
+        LoopbackBuffer_Write(m_pDmaBuffer + bufferOffset, runWrite, channels);
+        bufferOffset = (bufferOffset + runWrite) % m_ulDmaBufferSize;
+        ByteDisplacement -= runWrite;
+    }
+}
+
 //=============================================================================
 #pragma code_seg("PAGE")
 STDMETHODIMP_(NTSTATUS) 
